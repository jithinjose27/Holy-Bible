{
  "id": "NAM",
  "name": "Nahum",
  "slug": "nahum",
  "translation": "EasyEnglish Bible (EASY)",
  "publisher": "MissionAssist UK",
  "referenceUrl": "https://www.easyenglish.bible/bible/easy/nahum/",
  "totalChapters": 3,
  "totalVerses": 47,
  "chapters": [
    {
      "chapter": 1,
      "title": "Nahum 1",
      "subtitle": "",
      "totalVerses": 15,
      "sourceUrl": "https://www.easyenglish.bible/bible/easy/nahum/1/",
      "sections": [
        {
          "heading": "God always punishes his enemies",
          "items": [
            [
              {
                "verse": 1,
                "text": "This is a message that God showed as a vision to Nahum, who lived in Elkosh. It is a message about the people of Nineveh."
              }
            ],
            [
              {
                "verse": 2,
                "text": "The Lord wants people to worship only him."
              }
            ],
            [
              {
                "verse": 2,
                "text": "If people turn against him, he punishes them.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "He becomes very angry with his enemies.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "He pays them back as they deserve.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "He continues to be angry with his enemies",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "until their punishment is complete.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "The Lord does not quickly become angry,"
              }
            ],
            [
              {
                "verse": 3,
                "text": "but he is a very powerful God.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "If people are guilty,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "he will surely punish them.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "You can see his power in the wind and the storms.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "The clouds are like dust under his feet.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "When he shouts a command at the sea, it becomes dry!"
              }
            ],
            [
              {
                "verse": 4,
                "text": "He causes water in the rivers to disappear too.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "The grass in the fields of Bashan and Carmel starts to die.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "The flowers of Lebanon die too.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "He causes the mountains and the hills to shake."
              }
            ],
            [
              {
                "verse": 5,
                "text": "The earth shakes as he appears.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "His power causes all the people in the world to shake.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 6,
                "text": "When the Lord is angry, nobody can stop him."
              }
            ],
            [
              {
                "verse": 6,
                "text": "His great anger can destroy anyone.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 6,
                "text": "He pours out his anger like flames of fire.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 6,
                "text": "It causes rocks to break into pieces.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "The Lord is good!"
              }
            ],
            [
              {
                "verse": 7,
                "text": "He is a safe place for his people",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "when trouble comes to them.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "He takes care of people who trust him.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "But he will quickly destroy Nineveh."
              }
            ],
            [
              {
                "verse": 8,
                "text": "He will chase his enemies to a dark place of death.",
                "isContinuation": true
              }
            ]
          ]
        },
        {
          "heading": "Nahum warns Nineveh's people that God will destroy them",
          "items": [
            [
              {
                "verse": 9,
                "text": "Any plan that you make to hurt the Lord will be useless."
              }
            ],
            [
              {
                "verse": 9,
                "text": "He will only need to punish you once",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 9,
                "text": "and that will be the end of you!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "He will completely destroy his enemies."
              }
            ],
            [
              {
                "verse": 10,
                "text": "They will be like thorn bushes that a fire quickly destroys.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "They will be like wine that a drunk man quickly finishes.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "They will be like dry straw that a fire completely burns.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 11,
                "text": "Someone who makes wicked plans has come out from you, Nineveh."
              }
            ],
            [
              {
                "verse": 11,
                "text": "He wants to do evil things against the Lord.",
                "isContinuation": true
              }
            ]
          ]
        },
        {
          "heading": "God promises that his people will have peace",
          "items": [
            [
              {
                "verse": 12,
                "text": "This is what the Lord says:"
              }
            ],
            [
              {
                "verse": 12,
                "text": "‘The people of Assyria are very many",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "and they have a powerful army.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "But I will destroy them",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "so that they disappear.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "I have caused you, my people, to suffer,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "but I will not punish you any more.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "Now I will make you free from Assyria's power."
              }
            ],
            [
              {
                "verse": 13,
                "text": "I will break the chains that they have put on you, as their slaves.’",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "The Lord has spoken this command about you, king of Assyria. He says,"
              }
            ],
            [
              {
                "verse": 14,
                "text": "‘You will have no descendants",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "and your family name will disappear.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "I will destroy the idols and the images",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "that you worship in the temple of your gods.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "I will prepare your grave",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "because you are a useless king.’",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "People of Judah, look towards the mountains!"
              }
            ],
            [
              {
                "verse": 15,
                "text": "A messenger is coming with good news for you.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "He brings a message about peace.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "So you can have your special festivals again now.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "You can bring your offerings that you have promised to give to God.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "Those wicked people will not attack you any more.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "God has completely destroyed them.",
                "isContinuation": true
              }
            ]
          ]
        }
      ],
      "notes": [
        "Elkosh was a town in Judah.",
        "When we writeLordlike this, it is a special name for God. Sometimes people write it as the Hebrew name ‘Yahweh’. It is God's own name that he told Moses. SeeExodus 3:14. It means ‘I am who I am’. This shows that God has always been there and he always will be there.",
        "Bashan, Carmel and Lebanon were places where plants usually grew very well."
      ]
    },
    {
      "chapter": 2,
      "title": "Nahum 2",
      "subtitle": "",
      "totalVerses": 13,
      "sourceUrl": "https://www.easyenglish.bible/bible/easy/nahum/2/",
      "sections": [
        {
          "heading": "An enemy army will destroy Nineveh",
          "items": [
            [
              {
                "verse": 1,
                "text": "An enemy is coming to attack you, people of Nineveh."
              }
            ],
            [
              {
                "verse": 1,
                "text": "They want to chase you away.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 1,
                "text": "Put guards on the city's walls!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 1,
                "text": "Watch the road into the city!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 1,
                "text": "Prepare to fight with all your strength!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "Now the Lord will make Jacob's descendants great again."
              }
            ],
            [
              {
                "verse": 2,
                "text": "Enemy armies have attacked them.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "They have destroyed their land and their crops.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "But the Lord will make Israel and Judah great again.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "Strong soldiers are coming to attack you, Nineveh!"
              }
            ],
            [
              {
                "verse": 3,
                "text": "They have red shields and bright red clothes.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "They are ready for the battle!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "The metal on their chariots shines as bright as fire.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "The soldiers wave their spears in the air.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "They drive their chariots very fast through the streets."
              }
            ],
            [
              {
                "verse": 4,
                "text": "They rush here and there across the city's open places.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "Their chariots move like lightning.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "They shine like bright lights.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "The army leader commands his best soldiers to go forward."
              }
            ],
            [
              {
                "verse": 5,
                "text": "They almost fall as they run to the city wall.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "They put up their shields to cover their heads",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "as they prepare to attack.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 6,
                "text": "They open the river gates and water pours into the city."
              }
            ],
            [
              {
                "verse": 6,
                "text": "The water causes the palace to fall down.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "Nineveh's people must leave their city with much shame."
              }
            ],
            [
              {
                "verse": 7,
                "text": "Their enemy will lead them away as prisoners.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "The female slaves make sad noises like doves.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "They use their hands to hit themselves because they are upset.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "Nineveh is like a pool of water."
              }
            ],
            [
              {
                "verse": 8,
                "text": "Now its people are running away,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "like water that is pouring out of the pool.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "People shout at them, ‘Stop, stop!’",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "But nobody turns to come back.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 9,
                "text": "The enemy's soldiers say to each other,"
              }
            ],
            [
              {
                "verse": 9,
                "text": "‘We will take the silver and the gold for ourselves.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 9,
                "text": "The city is full of many valuable things.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 9,
                "text": "There is plenty for us all!’",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "The enemy takes every valuable thing from the city."
              }
            ],
            [
              {
                "verse": 10,
                "text": "They destroy anything that remains.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "They leave nothing.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "Nineveh's people are weak and afraid.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "Their knees and their whole bodies shake with fear.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "Their faces become white.",
                "isContinuation": true
              }
            ]
          ]
        },
        {
          "heading": "Nineveh no longer has any power",
          "items": [
            [
              {
                "verse": 11,
                "text": "What has happened to the great city of Nineveh?"
              }
            ],
            [
              {
                "verse": 11,
                "text": "It was like a home for strong lions.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 11,
                "text": "It was a place where the young lions could feed themselves.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 11,
                "text": "It was a safe place where whole families of lions could live.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 11,
                "text": "They were not afraid of any trouble.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "Nineveh's men were like lions"
              }
            ],
            [
              {
                "verse": 12,
                "text": "that could kill other animals for food.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "They could provide plenty of food",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "for their wives and their children.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "They could bring home as many valuable things as they wanted.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "But now the Lord Almighty says to Nineveh's people,"
              }
            ],
            [
              {
                "verse": 13,
                "text": "‘I am your enemy!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "I will use fire to destroy your chariots.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "I will cause your strong young men to die in battle.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "You will no longer be able to attack other nations",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "and take their things for yourselves.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "Other people will no longer listen to the voices of your messengers.’",
                "isContinuation": true
              }
            ]
          ]
        }
      ],
      "notes": [
        "Jacob was Abraham's grandson. God gave Jacob a new name, ‘Israel’. The 12tribesof Israel weredescendantsof Jacob's 12 sons.",
        "After King Solomon died, thenationof Israel became twokingdoms. The kingdom in the north was then called Israel and the kingdom in the south was called Judah."
      ]
    },
    {
      "chapter": 3,
      "title": "Nahum 3",
      "subtitle": "",
      "totalVerses": 19,
      "sourceUrl": "https://www.easyenglish.bible/bible/easy/nahum/3/",
      "sections": [
        {
          "heading": "God will punish Nineveh for her sins",
          "items": [
            [
              {
                "verse": 1,
                "text": "Terrible things will happen to you, Nineveh."
              }
            ],
            [
              {
                "verse": 1,
                "text": "Your people are murderers",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 1,
                "text": "and they love to tell lies.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 1,
                "text": "The city is full of valuable things",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 1,
                "text": "that belonged to other people.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "Listen to the sound of the enemy as they attack Nineveh!"
              }
            ],
            [
              {
                "verse": 2,
                "text": "The whips of the chariot drivers make a loud noise.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "The wheels of the chariots cause the ground to shake.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "Listen to the sound of the horses' feet as they pull the chariots.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 2,
                "text": "The chariots move so fast that they shake.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "The chariot drivers make their horses run forward to the battle."
              }
            ],
            [
              {
                "verse": 3,
                "text": "Their swords and their spears shine brightly in their hands.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "There are heaps of dead bodies.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "They lie everywhere on the ground.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 3,
                "text": "There are so many dead bodies that people fall over them.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "This has happened because Nineveh has lived like a beautiful prostitute."
              }
            ],
            [
              {
                "verse": 4,
                "text": "She has used magic to cause other nations to come to her.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "She catches people in her trap",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 4,
                "text": "and she makes them her slaves.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "The Lord Almighty says to Nineveh,"
              }
            ],
            [
              {
                "verse": 5,
                "text": "‘Now I have become your enemy.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "I will make you ashamed,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "like a woman whose skirt no longer covers her body.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "Other nations will see that you have no clothes.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 5,
                "text": "They will see your great shame.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 6,
                "text": "I will throw dirty rubbish at you."
              }
            ],
            [
              {
                "verse": 6,
                "text": "I will show everyone that you are useless.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 6,
                "text": "I will cause other people to laugh at you.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "When anyone sees you,"
              }
            ],
            [
              {
                "verse": 7,
                "text": "they will turn away from you.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "They will say, “Nineveh has become a heap of stones.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "But nobody will come to her funeral.”",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 7,
                "text": "Nobody will be there to comfort you.’",
                "isContinuation": true
              }
            ]
          ]
        },
        {
          "heading": "Nineveh's people will not save themselves",
          "items": [
            [
              {
                "verse": 8,
                "text": "Your city is no better than Thebes."
              }
            ],
            [
              {
                "verse": 8,
                "text": "That city was beside the Nile River.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "It had water all around it.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "The river protected the city,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 8,
                "text": "like a wall of water.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 9,
                "text": "Thebes trusted in the great power of Ethiopia and Egypt."
              }
            ],
            [
              {
                "verse": 9,
                "text": "Put and Libya were also her strong friends.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "But Thebes' enemies took her people away as prisoners."
              }
            ],
            [
              {
                "verse": 10,
                "text": "They killed her babies in the city's streets.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "They used lots to decide who would take each leader as their slave.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 10,
                "text": "They tied chains on the leaders and they led them away.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 11,
                "text": "Now you people of Nineveh will also become like men who are drunk."
              }
            ],
            [
              {
                "verse": 11,
                "text": "You will try to hide in a safe place.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 11,
                "text": "You will try to escape from your enemy.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "All your strong buildings are like fig trees"
              }
            ],
            [
              {
                "verse": 12,
                "text": "with ripe figs on them.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "When your enemy comes and shakes them,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 12,
                "text": "the figs will fall into their mouths!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "Look at your soldiers!"
              }
            ],
            [
              {
                "verse": 13,
                "text": "They will be like women, too weak to fight!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "Your enemies will push the gates of your city wide open.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 13,
                "text": "Fire will destroy the bars which hold the gates shut.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "Enemy soldiers will be all around the city, so get ready!"
              }
            ],
            [
              {
                "verse": 14,
                "text": "Store the water that you will need.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "Make your buildings strong.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 14,
                "text": "Prepare clay to make bricks for the walls.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "But fire will destroy your city."
              }
            ],
            [
              {
                "verse": 15,
                "text": "Soldiers will use their swords to kill you.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "They will destroy everything,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "as locusts destroy crops.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "Grow in number,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 15,
                "text": "like a large crowd of locusts or grasshoppers.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 16,
                "text": "You have many traders in your city."
              }
            ],
            [
              {
                "verse": 16,
                "text": "They are more than the stars in the sky.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 16,
                "text": "But they are like locusts.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 16,
                "text": "They take everything from the land and then they fly away!",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 17,
                "text": "Your guards and your officers are also like a crowd of locusts."
              }
            ],
            [
              {
                "verse": 17,
                "text": "On a cold day, they stay together on the walls to be warm.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 17,
                "text": "But when the sun comes up, they fly away.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 17,
                "text": "Nobody knows where they have gone.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 18,
                "text": "King of Assyria, your leaders are now asleep."
              }
            ],
            [
              {
                "verse": 18,
                "text": "Your officers will never wake up again.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 18,
                "text": "Your people have run away into the mountains.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 18,
                "text": "There is nobody to bring them back together.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 19,
                "text": "Your life will come to an end,"
              }
            ],
            [
              {
                "verse": 19,
                "text": "like someone with a terrible wound.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 19,
                "text": "Everyone will be very happy",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 19,
                "text": "when they hear what has happened to you.",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 19,
                "text": "You always did cruel things to people,",
                "isContinuation": true
              }
            ],
            [
              {
                "verse": 19,
                "text": "and nobody could escape.",
                "isContinuation": true
              }
            ]
          ]
        }
